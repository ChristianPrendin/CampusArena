rules_version = '2';

// CampusArena Firestore Security Rules.
//
// Trust model: Spark tier, no Cloud Functions — ELO, achievements, and
// match-timeout transitions are all evaluated CLIENT-SIDE (project_description.md
// §0, "Spark-Tier Trust Boundary"). Correctness of those client-computed values
// cannot be enforced here without server code; §2.2.1 concedes that. What these
// rules DO enforce is ownership where it is cheaply expressible: a queue ticket
// is writable only by its owner, except the no-show purge, which is gated on the
// parent facility actually being stale-free (get() + request.time) rather than
// left wide open.
//
// KNOWN RESIDUAL GAP (tracked follow-up, not "fine as-is"): match docs and rating
// docs are still writable by any signed-in user, so a client can forge
// `state: confirmed` + `eloDeltas` or overwrite an arbitrary rating. The
// promised badge-ID / request.time validation for cosmetic writes is likewise
// not yet expressed. Harden before any public launch — these are conceded, not
// endorsed.
//
// Why the facility `update` allowance exists: the queue join transaction writes
// the queue entry AND updates `facilities/{id}.queueTailPosition` in one atomic
// commit. If the rules permit the queue subcollection write but deny the parent
// facility update, the whole transaction is rejected — the "queueTailPosition
// never updates" symptom. The facility `update` allowance below unblocks it.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // True only in the narrow window the client-side no-show purge is also
    // allowed to run: the facility is free *right now* (see the queue-ticket
    // delete rule for why the status check can't be dropped) and has been free
    // longer than MatchRepository.staleQueueThreshold.
    function facilityIsStaleFree(facilityId) {
      let facility = get(/databases/$(database)/documents/facilities/$(facilityId)).data;
      return facility.status == 'free' &&
        request.time - facility.freedAt > duration.value(5, 'm');
    }

    // Profiles: world-readable (names/avatars render across leaderboards and
    // match cards). The owner writes their own doc freely; ANY signed-in user
    // may additionally write a doc when the write touches ONLY the `badges`
    // map. That exception exists because the confirm/dispute transaction
    // evaluates achievements for BOTH players and stamps each newly-earned
    // badge onto its owner's doc in one atomic commit — so the confirming user
    // (who is not the opponent) must be able to write the opponent's badges,
    // or the whole confirmation is rejected. Consistent with the conceded
    // trust gap above: badge writes are cosmetic and client-computed, so a
    // forged badge is no worse than the already-forgeable rating/match docs.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (
        request.auth.uid == uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['badges'])
      );
    }

    // Username uniqueness reservation: doc id IS the (lowercased) handle, and
    // the doc holds its owner's uid. A claim is created atomically with the
    // users/{uid} doc at registration; because it can never be updated or
    // deleted, a handle can never be re-pointed or stolen. This immutability is
    // what actually enforces uniqueness on the Spark tier (no Cloud Functions):
    // a second registration's transactional create of an existing doc fails.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.uid;
      // No update/delete: a claim is permanent (no rename path exists today).
    }

    // ELO ratings are client-computed under the Spark trust boundary.
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Facilities are seeded out-of-band; clients never create or delete them,
    // but MUST be able to update the denormalised session/queue fields
    // (status, currentMatchId, freedAt, queueTailPosition) during check-in and
    // queue joins.
    match /facilities/{facilityId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn();

      // Queue tickets are owner-scoped: a signed-in user writes only their own
      // ticket (doc id == uid). The one exception is the check-in no-show purge,
      // which deletes front-runners' tickets from another user's transaction —
      // gated by facilityIsStaleFree(), which requires BOTH a `free` status and
      // the stale-threshold timestamp.
      //
      // The status check is load-bearing, not redundant with the timestamp:
      // freedAt is only ever refreshed when a facility becomes free again
      // (confirmResult/disputeResult/abandonMatch/cancelMatch) — once a facility
      // has any match history at all, freedAt stays fixed at that last free
      // moment through every subsequent occupied/queued match. A timestamp-only
      // gate would therefore stay open for the entire duration of any match
      // running past 5 minutes, letting any signed-in user evict a live queue.
      // Requiring status == 'free' scopes the exception to the narrow window a
      // facility is legitimately transitioning out of free — the same window the
      // app's own client-side purge fires in (MatchRepository.createMatch throws
      // before ever computing purgeStale unless status == free). Within that
      // transaction, get() sees the pre-commit ('free') snapshot, so the
      // legitimate purge still passes even though the same transaction is
      // concurrently flipping status to occupied/queued.
      //
      // A null/absent freedAt makes the timestamp comparison fail, which
      // correctly falls back to owner-only.
      match /queue/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isSignedIn() &&
          (request.auth.uid == uid || facilityIsStaleFree(facilityId));
      }
    }

    // Matches: create is scoped to a participant (the creator must be in the new
    // doc's playerUids); update/delete stay open to any signed-in user because
    // the opponent-confirm and no-show-cancel paths act on docs they may not be
    // listed in. Validating result/confirm transitions is part of the tracked
    // hardening follow-up noted at the top of this file.
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.playerUids;
      allow update, delete: if isSignedIn();
    }

    // Tournaments + participants: organizer/bracket flows are client-driven.
    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
      match /participants/{uid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // Push-alert challenge targets.
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Reference data: read-only for clients; seeded by an admin script.
    match /achievementDefs/{achievementId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
