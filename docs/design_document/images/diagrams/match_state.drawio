        <mxCell id="t5" edge="1" parent="1" source="occupied" style="endArrow=block;html=1;dashed=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="abandoned" value="4h timeout&#xa;(resolveTimeout)">
