        <mxCell id="note" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontColor=#666666;whiteSpace=wrap;" value="free is not a match state — it is facility.status = free, the absence of an active match. Dashed transitions are evaluated lazily by whichever client next reads the facility or scans its QR code (no server)." vertex="1">
