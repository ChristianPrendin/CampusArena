        <mxCell id="e-bridge" edge="1" parent="1" source="p4" style="endArrow=block;html=1;strokeWidth=2;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="t1" value="enter transaction">
